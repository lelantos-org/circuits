    "absent": {
      "TxWitness.dummyAllOut": {
        "was": "main.all_dummy.out",
        "why": "`all_dummy.out === 0` (transact.circom:140) pins it, so the optimizer folds it to the constant. That constraint is `TransactSat.not_all_dummy`, and `TxWellFormed.someRealInput` is what it buys; if this signal comes back, the constraint is gone."
      },
      "OutputSlot.assetIsZero": {
        "was": "main.out_note[0].asset_nz.out",
        "why": "`asset_nz.out === 0` (output.circom:51) is unconditional on an output, unlike `SpentNote`'s `(1 - is_dummy) * asset_nz.out === 0`, which is why the spent counterpart survives and this does not. It is what keeps `packed_av >= 2^64`."
      },
      "TxWitness.dummyAcc": {
        "was": "main.dummy_acc[0]",
        "why": "`dummy_acc[0] <== 0` is the chain's base, folded to a constant. Later entries survive; the model's `dummy_acc_base` is this line."
      },
      "SpentSlot.cvDep": {
        "was": "main.spent[0].vc.cv_dep[0]",
        "why": "Merged into `main.spent[0].leaf_h.inputs[2]`, the only place a spent slot's `cv_dep` is read — it is hashed into the leaf and never published. The output side's `cv_dep` IS published and does survive, as `main.out_cv_dep`."
      },
      "TxWitness.vbRhs": {
        "was": "main.vbal.rhs[0][6]",
        "why": "The accumulator chains carry N_IN+1 and N_OUT+1 entries, and the top of the rhs chain is gone because `lhs[c][N_IN] === rhs[c][N_OUT]` (balance.circom:133) merges it with the top of the lhs chain. That equality is `PerAssetValueBalanceSat.balanced`, the constraint the whole conservation result rests on; if this signal reappears, the two sides are no longer equated."
      },
      "SpentSlot.mpChain": {
        "was": "main.spent[0].mp.mr.cur[0]",
        "why": "`cur[0] <== leaf` aliases the leaf hash, and the top `cur[DEPTH]` aliases `mp.mr.root`. Both ends of the chain are merged; the interior levels survive."
      }
    },
    "aliases": {
      "SpentSlot.cvDep": "main.spent[{i<N_IN}].leaf_h.inputs[2]",
      "SpentSlot.mpChain": "main.spent[{i<N_IN}].mp.mr.cur[1]"
    }
  },
