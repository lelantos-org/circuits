    "absent": {
      "BatchSignals.runningRoot": {
        "was": "main.running_root[0]",
        "why": "`running_root[0] <== old_root` and `new_root === running_root[MAX_L]` merge both ends of the chain with the public inputs. The interior survives, which is what `batch_advances_by_count` walks."
      },
      "BatchSignals.fr": {
        "was": "main.fr[0][0][0]",
        "why": "`fr[0][lvl][s] <== frontier_in[lvl][s]` merges the base of the frontier chain with the input. `fr[1..MAX_L]` survive."
      }
    },
    "aliases": {
      "BatchSignals.runningRoot": "main.running_root[1]",
      "BatchSignals.fr": "main.fr[1][{d<DEPTH}][0]"
    }
  }
