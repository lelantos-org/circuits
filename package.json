{
  "name": "@lelantos-org/circuits",
  "version": "0.4.1",
  "description": "Lelantos MASP Groth16 prover artifacts (2x2 transact circuit). PROTOTYPE — single-contributor zkey, NOT mainnet-safe.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "build/2x2.wasm",
    "build/2x2_final.zkey",
    "build/verification_key.json",
    "README.md"
  ],
  "exports": {
    "./2x2/2x2.wasm": "./build/2x2.wasm",
    "./2x2/2x2_final.zkey": "./build/2x2_final.zkey",
    "./2x2/verification_key.json": "./build/verification_key.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelantos-org/circuits.git"
  },
  "scripts": {
    "test": "FUZZ=medium NODE_OPTIONS=\"--import tsx/esm\" mocha --reporter spec --timeout 600000 'src/test/**/*.test.ts'",
    "test:unit": "FUZZ=medium NODE_OPTIONS=\"--import tsx/esm\" mocha --reporter spec --timeout 600000 --ignore 'src/test/fuzz/**' 'src/test/**/*.test.ts'",
    "test:fuzz": "FUZZ=${FUZZ:-heavy} NODE_OPTIONS=\"--import tsx/esm\" mocha --reporter spec --timeout 1800000 'src/test/fuzz/**/*.test.ts'",
    "package": "just package",
    "prepublishOnly": "just package"
  },
  "devDependencies": {
    "@lelantos-org/sdk": "^0.3.6",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.10",
    "chai": "^4.4.1",
    "circom_tester": "^0.0.20",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "fast-check": "^3.23.2",
    "mocha": "^10.7.0",
    "snarkjs": "^0.7.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3"
  }
}
