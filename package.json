{
  "name": "@lelantos-org/circuits",
  "version": "0.11.2",
  "description": "Lelantos MASP Groth16 prover artifacts.",
  "license": "MIT",
  "type": "module",
  "files": [
    "build/4x6.wasm",
    "build/4x6_final.zkey",
    "build/4x6_verification_key.json",
    "vectors/index.json",
    "vectors/transact-4x6.json",
    "vectors/tree-update-batch-8.json",
    "README.md"
  ],
  "exports": {
    "./4x6/4x6.wasm": "./build/4x6.wasm",
    "./4x6/4x6_final.zkey": "./build/4x6_final.zkey",
    "./4x6/verification_key.json": "./build/4x6_verification_key.json",
    "./vectors": "./vectors/index.json",
    "./vectors/transact-4x6.json": "./vectors/transact-4x6.json",
    "./vectors/tree-update-batch-8.json": "./vectors/tree-update-batch-8.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelantos-org/circuits.git"
  },
  "scripts": {
    "test": "FUZZ=${FUZZ:-medium} NODE_OPTIONS=\"--import tsx/esm\" mocha --reporter spec --timeout 600000 --exit 'test/**/*.test.ts'",
    "test:unit": "FUZZ=${FUZZ:-medium} NODE_OPTIONS=\"--import tsx/esm\" mocha --reporter spec --timeout 600000 --exit --ignore 'test/fuzz/**' 'test/**/*.test.ts'",
    "test:fuzz": "FUZZ=${FUZZ:-heavy} NODE_OPTIONS=\"--import tsx/esm\" mocha --reporter spec --timeout 1800000 --exit 'test/fuzz/**/*.test.ts'",
    "package": "just package",
    "vectors": "NODE_OPTIONS=\"--import tsx/esm\" node scripts/gen-vectors.ts"
  },
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.10",
    "chai": "^4.4.1",
    "circom_tester": "^0.0.20",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "fast-check": "^3.23.2",
    "mocha": "^10.7.0",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3"
  }
}
